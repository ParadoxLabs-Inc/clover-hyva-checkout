<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Hyva theme: swap the Luma per-method paymentinfo templates for the shared
             TokenBaseHyvaCheckout ones, and attach the Clover SDK payment pane. Retemplating (not
             remove-and-replace) is safe because ParadoxLabs\Clover\Block\Customer\Form does not
             override _toHtml()/_template, so the layout template assignment sticks. -->
        <referenceBlock name="tokenbase_manage_paradoxlabs_clover" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/method.phtml"/>
        <referenceBlock name="tokenbase_manage_paradoxlabs_clover_cards" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/cards.phtml"/>
        <referenceBlock name="tokenbase_manage_paradoxlabs_clover_form" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/form.phtml">
            <block class="Magento\Framework\View\Element\Template" name="tokenbase_manage_paradoxlabs_clover_form_pane" as="payment_pane" template="ParadoxLabs_CloverHyvaCheckout::customer/form/cc.phtml"/>
        </referenceBlock>
    </body>
</page>
